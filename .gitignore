__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Packaging and distribution
build/
dist/
*.egg-info/
*.egg

# Pytest / testing artifacts
.pytest_cache/
.coverage
htmlcov/

# IDE and editor files
.idea/
.vscode/

# Operating system files
.DS_Store

# Generated output files (keep directory via .gitkeep)
examples/output/*
!examples/output/.gitkeep
